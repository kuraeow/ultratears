+static char* find_fusermount_checked(bool verbose, char** fallback);
+
+/* UltraTears: started by Steam on a Steam Deck (Game Mode and desktop), the AppImage printed "No suitable fusermount
+ * binary found on the $PATH" with /usr/bin/fusermount3 setuid root there, while FUSERMOUNT_PROG=/usr/bin/fusermount3
+ * made it start (2026-11-01). Why the search fails under Steam's launch wrapper is not known (not SIGCHLD ignored,
+ * not an unmapped user namespace: tried in WSL). So: the check runs with SIGCHLD at its default and looks at
+ * waitpid's result; when no candidate passes, a setuid root fusermount3 (else fusermount) seen on the way is used;
+ * when none was seen, the usual absolute paths (as FUSERMOUNT_PROG named it). What it saw goes to stderr then. */
+static const char* const fusermount_known[] = {"/usr/bin/fusermount3", "/bin/fusermount3", "/usr/bin/fusermount", "/bin/fusermount", NULL};
+
 char* find_fusermount(bool verbose) {
+    struct sigaction dfl, old;
+    memset(&dfl, 0, sizeof dfl);
+    dfl.sa_handler = SIG_DFL;
+    sigemptyset(&dfl.sa_mask);
+    int restore = sigaction(SIGCHLD, &dfl, &old) == 0;
+    char* fallback = NULL;
+    char* found = find_fusermount_checked(verbose, &fallback);
+    if (restore) {
+        sigaction(SIGCHLD, &old, NULL);
+    }
+    if (found != NULL) {
+        free(fallback);
+        return found;
+    }
+    if (fallback != NULL) {
+        fprintf(stderr, "UltraTears runtime: no fusermount on PATH passed --version (PATH=%s): using %s\n",
+                getenv("PATH") ? getenv("PATH") : "(none)", fallback);
+        return fallback;
+    }
+    for (int i = 0; fusermount_known[i] != NULL; i++) {
+        struct stat sb;
+        int st = stat(fusermount_known[i], &sb);
+        fprintf(stderr, "UltraTears runtime: no fusermount found on PATH=%s; %s: %s, uid %d, mode %o\n",
+                getenv("PATH") ? getenv("PATH") : "(none)", fusermount_known[i], st == 0 ? "there" : strerror(errno),
+                st == 0 ? (int)sb.st_uid : -1, st == 0 ? (unsigned)sb.st_mode : 0u);
+        if (st == 0 && access(fusermount_known[i], X_OK) == 0) {
+            return strdup(fusermount_known[i]);
+        }
+    }
+    return NULL;
+}
