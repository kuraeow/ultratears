+static char* find_fusermount_checked(bool verbose, char** fallback);
+
+/* UltraTears: Steam starts games with SIGCHLD ignored, and then the kernel reaps the "--version" child itself: waitpid
+ * fails with ECHILD, the status is never set, and every working fusermount was rejected ("No suitable fusermount
+ * binary found on the $PATH", from Steam only: the same AppImage started from a file manager worked). The check now
+ * runs with SIGCHLD at its default, and a setuid root fusermount3 (else fusermount) found on the way is used when no
+ * candidate passed it. */
 char* find_fusermount(bool verbose) {
+    struct sigaction dfl, old;
+    memset(&dfl, 0, sizeof dfl);
+    dfl.sa_handler = SIG_DFL;
+    sigemptyset(&dfl.sa_mask);
+    int restore = sigaction(SIGCHLD, &dfl, &old) == 0;
+    char* fallback = NULL;
+    char* found = find_fusermount_checked(verbose, &fallback);
+    if (restore) {
+        sigaction(SIGCHLD, &old, NULL);
+    }
+    if (found != NULL) {
+        free(fallback);
+        return found;
+    }
+    if (fallback != NULL && verbose) {
+        printf("No fusermount passed --version: using %s\n", fallback);
+    }
+    return fallback;
+}
